import { useState } from "react";
import { useRouter } from "expo-router";
import { View, Text, TouchableOpacity, StyleSheet, Dimensions } from "react-native";
import Animated, { FadeInUp, FadeOutUp, FadeIn } from "react-native-reanimated";

const { width, height } = Dimensions.get("window");

const slides = [
  {
    id: 0,
    emoji: "🚨",
    title: "Vietnamese for\nTravelers",
    subtitle:
      "Instantly find the right Vietnamese phrase for any situation — airport, hospital, hotel, and more.",
    bg: "#FFD600",
    textColor: "#1C1C1E",
  },
  {
    id: 1,
    emoji: "🗣️",
    title: "Speak Like\na Local",
    subtitle:
      "Listen, repeat, and perfect your Vietnamese accent with interactive audio exercises.",
    bg: "#1C1C1E",
    textColor: "#FFD600",
  },
  {
    id: 2,
    emoji: "📚",
    title: "Track Your\nProgress",
    subtitle:
      "Every phrase you learn is saved. Review your history and watch your Vietnamese grow day by day.",
    bg: "#FFD600",
    textColor: "#1C1C1E",
  },
];

export default function Onboarding() {
  const router = useRouter();
  const [current, setCurrent] = useState(0);

  const handleNext = () => {
    if (current < slides.length - 1) {
      setCurrent(current + 1);
    } else {
      router.replace("/");
    }
  };

  const handleSkip = () => {
    router.replace("/");
  };

  const slide = slides[current];

  return (
    <Animated.View
      entering={FadeIn}
      style={[styles.container, { backgroundColor: slide.bg }]}
    >
      {/* Skip Button */}
      <View style={styles.skipContainer}>
        <TouchableOpacity onPress={handleSkip} style={styles.skipButton}>
          <Text style={[styles.skipText, { color: slide.textColor, opacity: 0.5 }]}>
            Skip
          </Text>
        </TouchableOpacity>
      </View>

      {/* Content */}
      <View style={styles.contentContainer}>
        <Animated.View
          key={current}
          entering={FadeInUp.duration(350)}
          exiting={FadeOutUp.duration(350)}
          style={styles.slideContent}
        >
          {/* Emoji Icon */}
          <View
            style={[
              styles.emojiContainer,
              {
                backgroundColor:
                  slide.textColor === "#1C1C1E"
                    ? "rgba(28,28,30,0.1)"
                    : "rgba(255,214,0,0.15)",
                borderColor: "rgba(0,0,0,0.05)",
              },
            ]}
          >
            <Text style={styles.emoji}>{slide.emoji}</Text>
          </View>

          {/* Title */}
          <Text style={[styles.title, { color: slide.textColor }]}>
            {slide.title}
          </Text>

          {/* Subtitle */}
          <Text style={[styles.subtitle, { color: slide.textColor }]}>
            {slide.subtitle}
          </Text>
        </Animated.View>
      </View>

      {/* Bottom Section */}
      <View style={styles.bottomContainer}>
        {/* Dots */}
        <View style={styles.dotsContainer}>
          {slides.map((_, i) => (
            <TouchableOpacity
              key={i}
              onPress={() => setCurrent(i)}
              style={[
                styles.dot,
                {
                  width: i === current ? 32 : 8,
                  backgroundColor: slide.textColor,
                  opacity: i === current ? 1 : 0.25,
                },
              ]}
            />
          ))}
        </View>

        {/* Continue Button */}
        <TouchableOpacity
          onPress={handleNext}
          style={[
            styles.continueButton,
            { backgroundColor: slide.textColor },
          ]}
          activeOpacity={0.8}
        >
          <Text style={[styles.continueText, { color: slide.bg }]}>
            {current < slides.length - 1 ? "Continue" : "Get Started"}
          </Text>
        </TouchableOpacity>
      </View>
    </Animated.View>
  );
}

const styles = StyleSheet.create({
  container: {
    flex: 1,
    width: "100%",
    height: "100%",
  },
  skipContainer: {
    flexDirection: "row",
    justifyContent: "flex-end",
    paddingHorizontal: 16,
    paddingTop: 56,
  },
  skipButton: {
    padding: 8,
  },
  skipText: {
    fontSize: 14,
    fontWeight: "600",
  },
  contentContainer: {
    flex: 1,
    justifyContent: "center",
    alignItems: "center",
    paddingHorizontal: 16,
  },
  slideContent: {
    alignItems: "center",
    justifyContent: "center",
  },
  emojiContainer: {
    width: 112,
    height: 112,
    borderRadius: 24,
    justifyContent: "center",
    alignItems: "center",
    marginBottom: 40,
    borderWidth: 1,
  },
  emoji: {
    fontSize: 64,
  },
  title: {
    fontSize: 32,
    fontWeight: "700",
    lineHeight: 35,
    textAlign: "center",
    marginBottom: 16,
  },
  subtitle: {
    fontSize: 14,
    lineHeight: 21,
    textAlign: "center",
    opacity: 0.7,
    maxWidth: 300,
  },
  bottomContainer: {
    paddingHorizontal: 16,
    paddingBottom: 48,
  },
  dotsContainer: {
    flexDirection: "row",
    justifyContent: "center",
    gap: 8,
    marginBottom: 32,
  },
  dot: {
    height: 8,
    borderRadius: 4,
  },
  continueButton: {
    width: "100%",
    paddingVertical: 16,
    borderRadius: 16,
    alignItems: "center",
    justifyContent: "center",
  },
  continueText: {
    fontSize: 16,
    fontWeight: "700",
  },
});
