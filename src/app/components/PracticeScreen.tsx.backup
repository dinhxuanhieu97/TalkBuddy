import { useState } from "react";
import { motion } from "motion/react";
import {
  Play,
  CheckCircle2,
  ChevronRight,
  BookOpen,
  Mic2,
  BrainCircuit,
} from "lucide-react";

export function PracticeScreen() {
  const [selectedCategory, setSelectedCategory] = useState("Daily");

  const categories = ["Daily", "Travel", "Work", "Emergency"];

  const practices = [
    {
      title: "Pronunciation",
      description: "Master the 6 tones and difficult consonants.",
      icon: <Mic2 size={24} className="text-[#1C1C1E]" />,
      progress: 65,
      color: "#FFD600",
    },
    {
      title: "Sentence Builder",
      description: "Practice S-V-O structures in common scenarios.",
      icon: <BrainCircuit size={24} className="text-[#1C1C1E]" />,
      progress: 42,
      color: "#00E5FF", // A splash of Cyan as accent
    },
    {
      title: "Listening Lab",
      description: "Listen to native speakers and transcribe.",
      icon: <BookOpen size={24} className="text-[#1C1C1E]" />,
      progress: 15,
      color: "#FFD600",
    },
  ];

  return (
    <div className="w-full h-full flex flex-col bg-[#F9F9F9] overflow-hidden">
      {/* Header */}
      <div className="px-4 pt-14 pb-8 bg-[#FFD600] flex flex-col gap-6">
        <h1 className="text-4xl font-black text-[#1C1C1E] leading-tight">
          Practice.
        </h1>
        <div className="flex gap-2 overflow-x-auto pb-2 no-scrollbar">
          {categories.map((cat) => (
            <button
              key={cat}
              onClick={() => setSelectedCategory(cat)}
              className={`px-6 py-2.5 rounded-full text-sm font-bold transition-all whitespace-nowrap ${
                selectedCategory === cat
                  ? "bg-[#1C1C1E] text-white"
                  : "bg-white/30 text-[#1C1C1E]"
              }`}
            >
              {cat}
            </button>
          ))}
        </div>
      </div>

      {/* Content */}
      <div className="flex-1 overflow-y-auto px-4 py-8 space-y-6">
        <div className="flex flex-col gap-4">
          <p className="text-[10px] font-bold text-[#9E9E9E] uppercase tracking-widest px-2">
            Daily Challenges
          </p>

          {practices.map((item, idx) => (
            <motion.div
              key={idx}
              initial={{ opacity: 0, y: 10 }}
              animate={{ opacity: 1, y: 0 }}
              transition={{ delay: idx * 0.1 }}
              className="p-6 bg-white rounded-[32px] border border-gray-100 flex flex-col gap-6 active:scale-[0.98] transition-all"
            >
              <div className="flex items-start justify-between">
                <div className="flex items-center gap-4">
                  <div
                    className={`w-14 h-14 rounded-2xl flex items-center justify-center`}
                    style={{ backgroundColor: item.color }}
                  >
                    {item.icon}
                  </div>
                  <div className="flex flex-col">
                    <h3 className="text-lg font-bold text-[#1C1C1E]">
                      {item.title}
                    </h3>
                    <p className="text-sm text-[#9E9E9E] leading-tight">
                      {item.description}
                    </p>
                  </div>
                </div>
                <div className="p-2">
                  <Play size={24} fill="#1C1C1E" />
                </div>
              </div>

              <div className="flex flex-col gap-2">
                <div className="flex justify-between items-end">
                  <span className="text-[10px] font-bold text-[#9E9E9E] uppercase">
                    Progress
                  </span>
                  <span className="text-[12px] font-bold text-[#1C1C1E]">
                    {item.progress}%
                  </span>
                </div>
                <div className="w-full h-2 bg-[#F3F3F5] rounded-full overflow-hidden">
                  <motion.div
                    initial={{ width: 0 }}
                    animate={{ width: `${item.progress}%` }}
                    className="h-full bg-[#1C1C1E]"
                  />
                </div>
              </div>
            </motion.div>
          ))}
        </div>

        {/* Weekly Stats Card */}
        <div className="bg-[#1C1C1E] rounded-[32px] p-8 text-white flex flex-col gap-6">
          <div className="flex items-center gap-4">
            <div className="w-12 h-12 rounded-full bg-[#FFD600] flex items-center justify-center">
              <CheckCircle2 size={24} className="text-[#1C1C1E]" />
            </div>
            <div className="flex flex-col">
              <h3 className="text-lg font-bold">Weekly Streak</h3>
              <p className="text-sm opacity-60">You're doing great!</p>
            </div>
          </div>

          <div className="flex justify-between">
            {["M", "T", "W", "T", "F", "S", "S"].map((day, i) => (
              <div key={i} className="flex flex-col items-center gap-2">
                <div
                  className={`w-8 h-8 rounded-lg flex items-center justify-center text-[10px] font-bold ${i < 3 ? "bg-[#FFD600] text-[#1C1C1E]" : "bg-white/10 text-white"}`}
                >
                  {day}
                </div>
              </div>
            ))}
          </div>

          <button className="w-full py-4 rounded-2xl bg-white/10 text-white text-[12px] font-bold uppercase tracking-widest flex items-center justify-center gap-2">
            View full stats <ChevronRight size={16} />
          </button>
        </div>
      </div>
    </div>
  );
}

export default PracticeScreen;
