import { useState } from "react";
import { motion, AnimatePresence } from "motion/react";
import {
  User,
  Lock,
  Settings,
  HelpCircle,
  Info,
  LogOut,
  ChevronRight,
  Bell,
  Globe,
  Volume2,
  Trash2,
  Mail,
  Camera,
  ArrowLeft,
  Check,
  Eye,
  EyeOff,
} from "lucide-react";

const AVATARS = [
  "https://images.unsplash.com/photo-1631284443067-d875ada6ff9f?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&ixid=M3w3Nzg4Nzd8MHwxfHNlYXJjaHwxfHxhc2lhbiUyMHlvdW5nJTIwd29tYW4lMjBzdHVkZW50JTIwc21pbGluZ3xlbnwxfHx8fDE3NzM4NDY3OTZ8MA&ixlib=rb-4.1.0&q=80&w=400",
  "https://images.unsplash.com/photo-1590905775253-a4f0f3c426ff?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&ixid=M3w3Nzg4Nzd8MHwxfHNlYXJjaHwxfHxzbWlsaW5nJTIwcGVyc29uJTIwYXZhdGFyJTIwcG9ydHJhaXR8ZW58MXx8fHwxNzc0MjUwMDM2fDA&ixlib=rb-4.1.0&q=80&w=400",
  "https://images.unsplash.com/photo-1686044905964-f0c1e55be7ea?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&ixid=M3w3Nzg4Nzd8MHwxfHNlYXJjaHwxfHxjb29sJTIweW91bmclMjBwZXJzb24lMjBhdmF0YXIlMjBwb3J0cmFpdHxlbnwxfHx8fDE3NzQzNDgxODV8MA&ixlib=rb-4.1.0&q=80&w=400",
  "https://images.unsplash.com/photo-1662131731759-aa614e7d5708?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&ixid=M3w3Nzg4Nzd8MHwxfHNlYXJjaHwxfHxmcmllbmRseSUyMGZhY2UlMjBhdmF0YXIlMjBwb3J0cmFpdHxlbnwxfHx8fDE3NzQzNDgxODV8MA&ixlib=rb-4.1.0&q=80&w=400",
  "https://images.unsplash.com/photo-1760574734202-f4b1cb30030d?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&ixid=M3w3Nzg4Nzd8MHwxfHNlYXJjaHwxfHxjcmVhdGl2ZSUyMHBlcnNvbiUyMGF2YXRhciUyMHBvcnRyYWl0fGVufDF8fHx8MTc3NDM0ODE4NXww&ixlib=rb-4.1.0&q=80&w=400",
  "https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&q=80&w=400",
];

type ActiveStep = "main" | "editName" | "editPassword" | "editAvatar";

export function ProfileScreen() {
  const [activeStep, setActiveStep] = useState<ActiveStep>("main");
  const [userData, setUserData] = useState({
    name: "Minh Anh",
    email: "minh.anh@email.com",
    avatar: AVATARS[0],
  });

  const [notifOn, setNotifOn] = useState(true);
  const [soundOn, setSoundOn] = useState(true);
  const [showPassword, setShowPassword] = useState(false);

  // Form states
  const [tempName, setTempName] = useState(userData.name);
  const [passwords, setPasswords] = useState({ old: "", new: "", confirm: "" });

  const handleSaveName = () => {
    setUserData({ ...userData, name: tempName });
    setActiveStep("main");
  };

  const handleSaveAvatar = (url: string) => {
    setUserData({ ...userData, avatar: url });
    setActiveStep("main");
  };

  const handleSavePassword = () => {
    // Mock save
    setPasswords({ old: "", new: "", confirm: "" });
    setActiveStep("main");
  };

  const menuSections = [
    {
      title: "Account",
      items: [
        {
          icon: <User size={20} />,
          label: "Personal Info",
          value: userData.name,
          color: "#5F6DF6",
          onClick: () => {
            setTempName(userData.name);
            setActiveStep("editName");
          },
        },
        {
          icon: <Lock size={20} />,
          label: "Password",
          value: "••••••••",
          color: "#FFD600",
          onClick: () => setActiveStep("editPassword"),
        },
        {
          icon: <Mail size={20} />,
          label: "Email",
          value: userData.email,
          color: "#00B8D9",
        },
      ],
    },
    {
      title: "Settings",
      items: [
        {
          icon: <Bell size={20} />,
          label: "Daily Reminder",
          hasToggle: true,
          toggleValue: notifOn,
          onToggle: () => setNotifOn(!notifOn),
        },
        {
          icon: <Volume2 size={20} />,
          label: "Sound Effects",
          hasToggle: true,
          toggleValue: soundOn,
          onToggle: () => setSoundOn(!soundOn),
        },
        {
          icon: <Globe size={20} />,
          label: "Learning Language",
          value: "Vietnamese",
        },
      ],
    },
    {
      title: "Support & App",
      items: [
        { icon: <HelpCircle size={20} />, label: "FAQ", color: "#1C1C1E" },
        { icon: <Info size={20} />, label: "About App", color: "#1C1C1E" },
      ],
    },
  ];

  return (
    <div className="w-full h-full flex flex-col bg-[#F9F9F9] relative overflow-hidden">
      <AnimatePresence mode="wait">
        {activeStep === "main" && (
          <motion.div
            key="main"
            initial={{ opacity: 0, x: -20 }}
            animate={{ opacity: 1, x: 0 }}
            exit={{ opacity: 0, x: -20 }}
            className="w-full h-full flex flex-col"
          >
            {/* Header */}
            <div className="px-6 pt-16 pb-10 bg-[#1C1C1E] rounded-b-[40px] shadow-lg relative overflow-hidden">
              <div className="absolute top-0 right-0 w-40 h-40 bg-[#FFD600]/10 rounded-full -mr-20 -mt-20 blur-3xl" />
              <div className="flex flex-col items-center relative z-10">
                <div
                  className="relative mb-4 group cursor-pointer"
                  onClick={() => setActiveStep("editAvatar")}
                >
                  <div className="w-24 h-24 rounded-[32px] overflow-hidden border-4 border-[#FFD600] shadow-2xl transition-transform active:scale-95">
                    <img
                      src={userData.avatar}
                      alt="Avatar"
                      className="w-full h-full object-cover"
                    />
                  </div>
                  <div className="absolute -bottom-2 -right-2 w-10 h-10 bg-[#FFD600] rounded-2xl flex items-center justify-center border-4 border-[#1C1C1E] shadow-lg">
                    <Camera size={18} className="text-[#1C1C1E]" />
                  </div>
                </div>
                <h2 className="text-2xl font-black text-white tracking-tight">
                  {userData.name}
                </h2>
                <p className="text-[13px] font-bold text-white/40 uppercase tracking-widest mt-1">
                  Premium Member
                </p>
              </div>
            </div>

            <div className="flex-1 overflow-y-auto px-4 pt-6 no-scrollbar pb-24">
              {menuSections.map((section, idx) => (
                <div key={idx} className="mb-8">
                  <p className="text-[11px] font-black text-[#9E9E9E] uppercase tracking-[0.2em] mb-4 px-2">
                    {section.title}
                  </p>
                  <div className="bg-white rounded-[32px] border border-gray-100 overflow-hidden shadow-sm">
                    {section.items.map((item, i) => (
                      <button
                        key={i}
                        disabled={!item.onClick && !item.hasToggle}
                        onClick={item.onClick}
                        className={`w-full flex items-center gap-4 px-6 py-5 text-left active:bg-gray-50 transition-colors ${i !== section.items.length - 1 ? "border-b border-gray-50" : ""}`}
                      >
                        <div
                          className="w-10 h-10 rounded-2xl flex items-center justify-center shrink-0"
                          style={{
                            backgroundColor: `${item.color || "#F3F3F5"}15`,
                            color: item.color || "#1C1C1E",
                          }}
                        >
                          {item.icon}
                        </div>
                        <div className="flex-1">
                          <p className="text-[14px] font-bold text-[#1C1C1E]">
                            {item.label}
                          </p>
                          {item.value && (
                            <p className="text-[12px] font-medium text-[#9E9E9E] mt-0.5">
                              {item.value}
                            </p>
                          )}
                        </div>

                        {item.hasToggle ? (
                          <div
                            onClick={(e) => {
                              e.stopPropagation();
                              item.onToggle?.();
                            }}
                            className={`relative w-12 h-7 rounded-full transition-all duration-300 ${item.toggleValue ? "bg-[#FFD600]" : "bg-[#E0E0E0]"}`}
                          >
                            <div
                              className={`absolute top-1 w-5 h-5 rounded-full bg-white shadow-md transition-all duration-300 ${item.toggleValue ? "left-6" : "left-1"}`}
                            />
                          </div>
                        ) : (
                          item.onClick && (
                            <ChevronRight size={18} className="text-gray-300" />
                          )
                        )}
                      </button>
                    ))}
                  </div>
                </div>
              ))}

              {/* Danger Zone */}
              <div className="space-y-3">
                <button className="w-full flex items-center gap-4 px-6 py-5 bg-white rounded-[32px] border border-gray-100 text-left shadow-sm active:scale-[0.98] transition-all">
                  <div className="w-10 h-10 rounded-2xl bg-red-50 flex items-center justify-center shrink-0 text-red-500">
                    <Trash2 size={20} />
                  </div>
                  <span className="flex-1 text-[14px] font-bold text-red-500">
                    Clear Learning History
                  </span>
                  <ChevronRight size={18} className="text-red-200" />
                </button>

                <button className="w-full flex items-center gap-4 px-6 py-5 bg-[#1C1C1E] rounded-[32px] text-left shadow-xl active:scale-[0.98] transition-all mb-4">
                  <div className="w-10 h-10 rounded-2xl bg-white/10 flex items-center justify-center shrink-0 text-[#FFD600]">
                    <LogOut size={20} />
                  </div>
                  <span className="flex-1 text-[14px] font-bold text-white">
                    Logout
                  </span>
                  <div className="px-3 py-1 bg-white/10 rounded-full text-[10px] font-bold text-white/40 uppercase tracking-widest">
                    v1.2.0
                  </div>
                </button>
              </div>
            </div>
          </motion.div>
        )}

        {/* Edit Name Sub-page */}
        {activeStep === "editName" && (
          <motion.div
            key="editName"
            initial={{ opacity: 0, x: 20 }}
            animate={{ opacity: 1, x: 0 }}
            exit={{ opacity: 0, x: 20 }}
            className="w-full h-full flex flex-col bg-white"
          >
            <div className="px-6 pt-16 pb-6 border-b border-gray-100 flex items-center justify-between">
              <button
                onClick={() => setActiveStep("main")}
                className="w-10 h-10 rounded-2xl bg-[#F3F3F5] flex items-center justify-center"
              >
                <ArrowLeft size={20} />
              </button>
              <h3 className="text-[17px] font-black tracking-tight">
                Personal Info
              </h3>
              <div className="w-10" />
            </div>
            <div className="flex-1 p-6 space-y-6">
              <div>
                <label className="text-[11px] font-black text-[#9E9E9E] uppercase tracking-widest mb-2 block px-1">
                  Display Name
                </label>
                <div className="bg-[#F3F3F5] rounded-[24px] px-6 py-5 border border-transparent focus-within:border-[#FFD600] transition-all">
                  <input
                    type="text"
                    value={tempName}
                    onChange={(e) => setTempName(e.target.value)}
                    className="w-full bg-transparent outline-none text-[15px] font-bold text-[#1C1C1E]"
                    autoFocus
                  />
                </div>
              </div>
              <p className="text-[13px] text-[#9E9E9E] px-1 font-medium leading-relaxed">
                This name will be visible to your practice buddies and on your
                profile card.
              </p>
            </div>
            <div className="p-6">
              <button
                onClick={handleSaveName}
                className="w-full h-16 bg-[#1C1C1E] text-white rounded-[32px] font-black text-[14px] uppercase tracking-widest flex items-center justify-center gap-2 active:scale-95 transition-transform"
              >
                <Check size={20} className="text-[#FFD600]" /> Save Changes
              </button>
            </div>
          </motion.div>
        )}

        {/* Edit Avatar Sub-page */}
        {activeStep === "editAvatar" && (
          <motion.div
            key="editAvatar"
            initial={{ opacity: 0, scale: 0.95 }}
            animate={{ opacity: 1, scale: 1 }}
            exit={{ opacity: 0, scale: 0.95 }}
            className="w-full h-full flex flex-col bg-white"
          >
            <div className="px-6 pt-16 pb-6 border-b border-gray-100 flex items-center justify-between">
              <button
                onClick={() => setActiveStep("main")}
                className="w-10 h-10 rounded-2xl bg-[#F3F3F5] flex items-center justify-center"
              >
                <ArrowLeft size={20} />
              </button>
              <h3 className="text-[17px] font-black tracking-tight">
                Choose Avatar
              </h3>
              <div className="w-10" />
            </div>
            <div className="flex-1 p-6">
              <div className="grid grid-cols-2 gap-4">
                {AVATARS.map((url, i) => (
                  <button
                    key={i}
                    onClick={() => handleSaveAvatar(url)}
                    className={`aspect-square rounded-[40px] overflow-hidden border-4 transition-all active:scale-90 ${userData.avatar === url ? "border-[#FFD600]" : "border-transparent"}`}
                  >
                    <img
                      src={url}
                      alt={`Avatar ${i}`}
                      className="w-full h-full object-cover"
                    />
                  </button>
                ))}
              </div>
            </div>
          </motion.div>
        )}

        {/* Edit Password Sub-page */}
        {activeStep === "editPassword" && (
          <motion.div
            key="editPassword"
            initial={{ opacity: 0, x: 20 }}
            animate={{ opacity: 1, x: 0 }}
            exit={{ opacity: 0, x: 20 }}
            className="w-full h-full flex flex-col bg-white"
          >
            <div className="px-6 pt-16 pb-6 border-b border-gray-100 flex items-center justify-between">
              <button
                onClick={() => setActiveStep("main")}
                className="w-10 h-10 rounded-2xl bg-[#F3F3F5] flex items-center justify-center"
              >
                <ArrowLeft size={20} />
              </button>
              <h3 className="text-[17px] font-black tracking-tight">
                Change Password
              </h3>
              <div className="w-10" />
            </div>
            <div className="flex-1 p-6 space-y-6 overflow-y-auto no-scrollbar">
              {[
                { label: "Current Password", key: "old" },
                { label: "New Password", key: "new" },
                { label: "Confirm New Password", key: "confirm" },
              ].map((field) => (
                <div key={field.key}>
                  <label className="text-[11px] font-black text-[#9E9E9E] uppercase tracking-widest mb-2 block px-1">
                    {field.label}
                  </label>
                  <div className="bg-[#F3F3F5] rounded-[24px] px-6 py-5 border border-transparent focus-within:border-[#FFD600] transition-all flex items-center gap-3">
                    <input
                      type={showPassword ? "text" : "password"}
                      value={(passwords as any)[field.key]}
                      onChange={(e) =>
                        setPasswords({
                          ...passwords,
                          [field.key]: e.target.value,
                        })
                      }
                      className="flex-1 bg-transparent outline-none text-[15px] font-bold text-[#1C1C1E]"
                      placeholder="••••••••"
                    />
                    <button
                      onClick={() => setShowPassword(!showPassword)}
                      className="text-[#9E9E9E]"
                    >
                      {showPassword ? <EyeOff size={18} /> : <Eye size={18} />}
                    </button>
                  </div>
                </div>
              ))}
              <p className="text-[12px] text-[#9E9E9E] px-1 font-medium">
                Make sure your new password is at least 8 characters long and
                includes numbers.
              </p>
            </div>
            <div className="p-6">
              <button
                onClick={handleSavePassword}
                className="w-full h-16 bg-[#1C1C1E] text-white rounded-[32px] font-black text-[14px] uppercase tracking-widest flex items-center justify-center gap-2 active:scale-95 transition-transform"
              >
                Update Password
              </button>
            </div>
          </motion.div>
        )}
      </AnimatePresence>
    </div>
  );
}

export default ProfileScreen;
