import { useState } from "react";
import { LearnScreen } from "./LearnScreen";
import { TalkBuddyScreen } from "./TalkBuddyScreen";
import { PracticeScreen } from "./PracticeScreen";
import { ProfileScreen } from "./ProfileScreen";
import {
  Search,
  TriangleAlert,
  User,
  MessageSquare,
  BookOpen,
} from "lucide-react";

type Tab = "learn" | "sos" | "practice" | "profile";

const tabs: { id: Tab; label: string; icon: React.ReactNode }[] = [
  {
    id: "learn",
    label: "Learn",
    icon: <BookOpen size={24} />,
  },
  {
    id: "sos",
    label: "SOS",
    icon: <TriangleAlert size={24} />,
  },
  {
    id: "practice",
    label: "Practice",
    icon: <MessageSquare size={24} />,
  },
  {
    id: "profile",
    label: "Profile",
    icon: <User size={24} />,
  },
];

export default function MainApp() {
  const [activeTab, setActiveTab] = useState<Tab>("learn");

  return (
    <div className="w-full h-full flex flex-col bg-white">
      {/* Screen Content */}
      <div className="flex-1 overflow-hidden">
        {activeTab === "learn" && <LearnScreen />}
        {activeTab === "sos" && <TalkBuddyScreen />}
        {activeTab === "practice" && <PracticeScreen />}
        {activeTab === "profile" && <ProfileScreen />}
      </div>

      {/* Bottom Nav */}
      <div
        className="flex items-center justify-around px-4 py-3 border-t border-gray-100"
        style={{
          backgroundColor: "#FFFFFF",
          paddingBottom: 32,
          borderTopLeftRadius: 32,
          borderTopRightRadius: 32,
        }}
      >
        {tabs.map((tab) => {
          const isActive = activeTab === tab.id;
          return (
            <button
              key={tab.id}
              onClick={() => setActiveTab(tab.id)}
              className="flex flex-col items-center gap-1 relative flex-1 active:scale-95 transition-transform"
            >
              {isActive ? (
                <div
                  className="flex items-center gap-2 px-6 py-2 rounded-full transition-all"
                  style={{ backgroundColor: "#FFD600" }}
                >
                  <span style={{ color: "#1C1C1E" }}>{tab.icon}</span>
                  <span
                    style={{
                      color: "#1C1C1E",
                      fontSize: 12,
                      fontWeight: 600,
                      letterSpacing: "-0.01em",
                    }}
                  >
                    {tab.label}
                  </span>
                </div>
              ) : (
                <div className="flex flex-col items-center gap-1 py-1 px-3">
                  <span style={{ color: "#9E9E9E" }}>{tab.icon}</span>
                  <span
                    style={{
                      color: "#9E9E9E",
                      fontSize: 10,
                      fontWeight: 600,
                      textTransform: "uppercase",
                      letterSpacing: "0.05em",
                    }}
                  >
                    {tab.label}
                  </span>
                </div>
              )}
            </button>
          );
        })}
      </div>
    </div>
  );
}
