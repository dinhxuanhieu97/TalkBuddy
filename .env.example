# Environment variables

# API Configuration - Use absolute URL pointing to backend
# Development: http://localhost:3000 (Next.js dev server)
# Production: https://talkbuddy.wayjet.io
EXPO_PUBLIC_API_URL=https://talkbuddy.wayjet.io

# TTS Service Configuration
# Development: http://localhost:8001 (Python TTS service)
# Production: https://tts.talkbuddy.wayjet.io
EXPO_PUBLIC_TTS_URL=http://localhost:8001
EXPO_PUBLIC_TTS_API_KEY=tts_service_secret_key

# Voice Settings Defaults
EXPO_PUBLIC_DEFAULT_VOICE_SPEED=1.0
EXPO_PUBLIC_DEFAULT_VOICE_GENDER=Female
EXPO_PUBLIC_DEFAULT_VOICE_ACCENT=US

# Feature Flags
EXPO_PUBLIC_ENABLE_AI_CHAT=true
EXPO_PUBLIC_ENABLE_PRACTICE_MODE=true
EXPO_PUBLIC_ENABLE_TTS=true
EXPO_PUBLIC_ENABLE_VOICE_CLONING=false

# Google OAuth - Get from Google Cloud Console
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Supabase - Get from Supabase Dashboard > Settings > API
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Analytics (optional)
EXPO_PUBLIC_ANALYTICS_ID=

# RevenueCat (IAP) - Get from RevenueCat dashboard
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

# EAS Configuration
EAS_PROJECT_ID=your-project-id-here
