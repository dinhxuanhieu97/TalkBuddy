# Environment variables

# API Configuration - Use absolute URL pointing to backend
# Development: http://localhost:3000 (Next.js dev server)
# Production: https://talkbuddy.wayjet.io
VITE_API_URL=https://talkbuddy.wayjet.io

# TTS Service Configuration
# Development: http://localhost:8001 (Python TTS service)
# Production: https://tts.talkbuddy.wayjet.io
VITE_TTS_URL=http://localhost:8001
VITE_TTS_API_KEY=tts_service_secret_key

# Voice Settings Defaults
VITE_DEFAULT_VOICE_SPEED=1.0
VITE_DEFAULT_VOICE_GENDER=Female
VITE_DEFAULT_VOICE_ACCENT=US

# Feature Flags
VITE_ENABLE_AI_CHAT=true
VITE_ENABLE_PRACTICE_MODE=true
VITE_ENABLE_TTS=true
VITE_ENABLE_VOICE_CLONING=false

# Google OAuth - Get from Google Cloud Console
VITE_GOOGLE_IOS_CLIENT_ID=
VITE_GOOGLE_ANDROID_CLIENT_ID=
VITE_GOOGLE_WEB_CLIENT_ID=

# Supabase - Get from Supabase Dashboard > Settings > API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Analytics (optional)
VITE_ANALYTICS_ID=

# RevenueCat (IAP) - Get from RevenueCat dashboard
VITE_REVENUECAT_IOS_KEY=
VITE_REVENUECAT_ANDROID_KEY=

# EAS Configuration
EAS_PROJECT_ID=your-project-id-here
